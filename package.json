{
  "name": "cv-gen",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@9.4.0",
  "type": "module",
  "homepage": "https://quoilam.github.io/cv-gen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quoilam/cv-gen.git"
  },
  "scripts": {
    "build": "pnpm --filter=site build",
    "dev": "pnpm --filter=site dev",
    "lint": "eslint .",
    "release": "pnpm build",
    "serve": "pnpm --filter=site serve",
    "test": "pnpm --filter=site test",
    "test:e2e": "pnpm --filter=site test:e2e",
    "test:e2e:ui": "pnpm --filter=site test:e2e:ui"
  },
  "prettier": "@renovamen/prettier-config",
  "devDependencies": {
    "@renovamen/eslint-config": "^0.1.7",
    "@renovamen/prettier-config": "^0.1.7",
    "eslint": "^9.6.0",
    "pnpm": "^9.4.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "9"
      }
    }
  }
}
